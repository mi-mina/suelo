<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

    <style>
      :root {
        --color-background-secondary: #f5f5f5;
        --color-background-success: #e8f5e9;
        --color-background-danger: #ffebee;
        --color-border-tertiary: #e0e0e0;
        --color-text-primary: #212121;
        --color-text-secondary: #616161;
        --color-text-tertiary: #9e9e9e;
        --color-text-success: #2e7d32;
        --color-text-danger: #c62828;
        --border-radius-md: 4px;
      }
      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
      }
      .top-bar {
        background: var(--color-background-secondary);
        border: 0.5px solid var(--color-border-tertiary);
        border-radius: var(--border-radius-md);
        padding: 10px 14px;
        margin-bottom: 1rem;
        font-size: 13px;
        color: var(--color-text-secondary);
      }
      .top-bar strong {
        color: var(--color-text-primary);
      }
      .ctrl-row {
        display: flex;
        gap: 20px;
        margin-bottom: 1rem;
        align-items: flex-end;
        flex-wrap: wrap;
      }
      .cg {
        display: flex;
        flex-direction: column;
        gap: 5px;
      }
      .cl {
        font-size: 13px;
        color: var(--color-text-secondary);
      }
      .cl b {
        font-weight: 500;
        color: var(--color-text-primary);
      }
      .floor-box {
        overflow-x: auto;
        border: 0.5px solid var(--color-border-tertiary);
        border-radius: var(--border-radius-md);
        padding: 10px 12px;
        background: var(--color-background-secondary);
        margin-bottom: 1rem;
      }
      .dimtxt {
        font-size: 12px;
        color: var(--color-text-tertiary);
        margin-top: 7px;
      }
      .inv {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
      }
      .inv th {
        text-align: left;
        padding: 6px 10px;
        font-weight: 500;
        color: var(--color-text-secondary);
        border-bottom: 0.5px solid var(--color-border-tertiary);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .inv td {
        padding: 7px 10px;
        border-bottom: 0.5px solid var(--color-border-tertiary);
        color: var(--color-text-primary);
      }
      .inv tr:last-child td {
        border-bottom: none;
      }
      .badge {
        display: inline-block;
        font-size: 12px;
        padding: 2px 8px;
        border-radius: var(--border-radius-md);
        font-weight: 500;
        min-width: 44px;
        text-align: center;
      }
      .ok {
        background: var(--color-background-success);
        color: var(--color-text-success);
      }
      .ko {
        background: var(--color-background-danger);
        color: var(--color-text-danger);
      }
      .na {
        background: var(--color-background-secondary);
        color: var(--color-text-tertiary);
      }
    </style>
  </head>
  <body>
    <h2 class="sr-only">Diseño de dos zonas con borde blanco perimetral</h2>

    <div class="top-bar">
      Salón <strong>8,32 × 3,88 m</strong> → <strong>42 × 20</strong> baldosas ·
      borde blanco <strong>2 filas</strong> · dos zonas iguales de motivo
    </div>

    <div class="ctrl-row">
      <button
        id="btn-dl"
        style="padding: 6px 14px; font-size: 13px; cursor: pointer">
        ⬇ Descargar imagen
      </button>
      <div class="cg">
        <label class="cl" for="rsep"
          >Separador entre zonas: <b id="vsep">2 fila</b></label
        >
        <input type="range" id="rsep" min="0" max="2" value="1" step="1" />
      </div>
      <div class="cg">
        <label class="cl" for="risep"
          >Fila blanca interior: <b id="visep">1 fila</b></label
        >
        <input type="range" id="risep" min="0" max="2" value="1" step="1" />
      </div>
      <div class="cg">
        <label class="cl" for="rnz"
          >Número de zonas: <b id="vnz">2 zonas</b></label
        >
        <input type="range" id="rnz" min="1" max="3" value="2" step="1" />
      </div>
    </div>

    <div class="floor-box">
      <svg id="flr" style="display: block"></svg>
      <div class="dimtxt" id="dimtxt"></div>
    </div>

    <table class="inv">
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Necesarias</th>
          <th>Disponibles</th>
          <th>Balance</th>
        </tr>
      </thead>
      <tbody id="inv-body"></tbody>
    </table>

    <script>
      (function () {
        const NS = "http://www.w3.org/2000/svg",
          SZ = 56.69;
        const ROWS = 20,
          COLS = 42,
          OUTER = 0;
        const STOCK = {
          esquina: 18,
          cenefa: 200,
          relleno: 500,
          blanco: 200,
        };
        const SLBL = ["sin separador", "1 blanca", "2 blancas"];

        function mk(tag, a) {
          const e = document.createElementNS(NS, tag);
          for (const [k, v] of Object.entries(a)) e.setAttribute(k, v);
          return e;
        }

        function drawTile(g, t, sw) {
          const ST = {
            fill: "none",
            stroke: "#521010",
            "stroke-width": sw,
            "stroke-miterlimit": "10",
          };
          function poly(p) {
            return mk("polyline", {...ST, points: p});
          }
          function seg(x1, y1, x2, y2) {
            return mk("line", {...ST, x1, y1, x2, y2});
          }
          if (t === "esquina") {
            g.append(
              poly(
                "56.69 17.01 34.01 17.01 34.01 28.34 51.02 28.34 51.02 39.69 39.69 39.69 39.69 51.02 28.35 51.02 28.34 34.01 17.01 34.01 17.01 56.69",
              ),
              poly("51.02 56.69 51.02 51.02 56.61 51.02"),
              poly("17.01 17.01 17.01 22.68 5.67 22.68 5.67 56.69"),
              poly("17.01 17.01 17.01 5.67 5.67 5.67 5.67 17.01 17.01 17.01"),
              poly("56.61 5.67 22.68 5.67 22.68 17.01 17.01 17.01"),
            );
          } else if (t === "cenefa") {
            g.append(
              seg(0, 5.67, 56.69, 5.67),
              seg(0, 51.02, 56.69, 51.02),
              poly(
                "0 17.01 22.68 17.01 22.68 28.35 5.67 28.35 5.67 39.69 51.02 39.69 51.02 28.35 34.01 28.35 34.01 17.01 56.69 17.01",
              ),
            );
          } else if (t === "relleno") {
            g.append(
              seg(0, 11.34, 56.69, 11.34),
              seg(0, 45.35, 56.69, 45.35),
              seg(11.34, 0, 11.34, 56.69),
              seg(45.35, 0, 45.35, 56.69),
            );
          }
        }

        function getCell(r, c, pad, innerSep, nz) {
          if (r < OUTER || r >= ROWS - OUTER || c < OUTER || c >= COLS - OUTER)
            return {t: "blanco", rot: 0};

          const ir = r - OUTER,
            ic = c - OUTER;
          const iR = ROWS - 2 * OUTER;
          const iC = COLS - 2 * OUTER;

          const total = iC - (nz + 1) * pad;
          const zH = iR - 2 * pad;
          if (total <= 0 || zH <= 0) return {t: "blanco", rot: 0};

          const base = Math.floor(total / nz);
          const extra = total % nz;
          const zWs = Array.from({length: nz}, (_, i) =>
            i < extra ? base + 1 : base,
          );

          const zStarts = [];
          let xs = pad;
          for (let i = 0; i < nz; i++) {
            zStarts.push(xs);
            xs += zWs[i] + pad;
          }

          const zRowStart = pad,
            zRowEnd = pad + zH;
          if (ir < zRowStart || ir >= zRowEnd) return {t: "blanco", rot: 0};

          let zIC = -1,
            zW;
          for (let i = 0; i < nz; i++) {
            if (ic >= zStarts[i] && ic < zStarts[i] + zWs[i]) {
              zIC = ic - zStarts[i];
              zW = zWs[i];
              break;
            }
          }
          if (zIC === -1) return {t: "blanco", rot: 0};

          const zIR = ir - zRowStart;
          const top = zIR === 0,
            bot = zIR === zH - 1,
            left = zIC === 0,
            right = zIC === zW - 1;

          if (top && left) return {t: "esquina", rot: 0};
          if (top && right) return {t: "esquina", rot: 90};
          if (bot && right) return {t: "esquina", rot: 180};
          if (bot && left) return {t: "esquina", rot: 270};
          if (top) return {t: "cenefa", rot: 0};
          if (right) return {t: "cenefa", rot: 90};
          if (bot) return {t: "cenefa", rot: 180};
          if (left) return {t: "cenefa", rot: 270};

          if (innerSep > 0) {
            if (
              zIR <= innerSep ||
              zIR >= zH - 1 - innerSep ||
              zIC <= innerSep ||
              zIC >= zW - 1 - innerSep
            )
              return {t: "blanco", rot: 0};
          }
          return {t: "relleno", rot: 0};
        }

        function render() {
          const pad = +document.getElementById("rsep").value;
          const isep = +document.getElementById("risep").value;
          const nz = +document.getElementById("rnz").value;
          document.getElementById("vsep").textContent = [
            "ninguna",
            "1 fila",
            "2 filas",
          ][pad];
          document.getElementById("visep").textContent = [
            "ninguna",
            "1 fila",
            "2 filas",
          ][isep];
          document.getElementById("vnz").textContent = [
            "",
            "1 zona",
            "2 zonas",
            "3 zonas",
          ][nz];

          const s = Math.floor(Math.min(900 / COLS, 550 / ROWS, 48));
          const sc = s / SZ;
          const sw = (Math.max(0.9, 1.8 * sc) / sc).toFixed(2);

          const svg = document.getElementById("flr");
          svg.setAttribute("width", COLS * s);
          svg.setAttribute("height", ROWS * s);
          svg.innerHTML = "";

          const cnt = {esquina: 0, cenefa: 0, relleno: 0, blanco: 0};

          for (let r = 0; r < ROWS; r++) {
            for (let c = 0; c < COLS; c++) {
              const {t, rot} = getCell(r, c, pad, isep, nz);
              cnt[t]++;
              const x = c * s,
                y = r * s;
              const bg = t === "blanco" ? "#f8f7f4" : "white";
              svg.appendChild(
                mk("rect", {
                  x,
                  y,
                  width: s,
                  height: s,
                  fill: bg,
                  stroke: "#b0a898",
                  "stroke-width": "0.4",
                }),
              );
              if (t !== "blanco") {
                const g = mk("g", {
                  transform: `translate(${x + s / 2},${y + s / 2}) rotate(${rot}) translate(${-s / 2},${-s / 2}) scale(${sc})`,
                });
                drawTile(g, t, sw);
                svg.appendChild(g);
              }
            }
          }

          const iC = COLS - 2 * OUTER;
          const total = iC - (nz + 1) * pad;
          const base = Math.floor(total / nz);
          const extra = total % nz;
          const zWs = Array.from({length: nz}, (_, i) =>
            i < extra ? base + 1 : base,
          );
          const zH = ROWS - 2 * OUTER - 2 * pad;
          const LABELS = ["A", "B", "C"];

          let xLabel = (OUTER + pad) * s;
          zWs.forEach((zW, i) => {
            const t = mk("text", {
              x: xLabel + (zW * s) / 2,
              y: (OUTER + pad) * s + (zH * s) / 2,
              "text-anchor": "middle",
              "dominant-baseline": "middle",
              fill: "rgba(120,100,80,0.15)",
              "font-size": `${Math.max(12, s * 2.5)}`,
              "font-weight": "600",
              "font-family": "system-ui",
              "pointer-events": "none",
            });
            t.textContent = LABELS[i];
            svg.appendChild(t);
            xLabel += (zW + pad) * s;
          });

          document.getElementById("dimtxt").textContent =
            `Margen: ${(pad * 0.2).toFixed(1)} m · ` +
            zWs
              .map((zW, i) => `Zona ${LABELS[i]}: ${(zW * 0.2).toFixed(2)} m`)
              .join(" · ") +
            ` · Alto: ${(zH * 0.2).toFixed(2)} m`;

          const TYPES = [
            {k: "esquina", l: "Esquina"},
            {k: "cenefa", l: "Cenefa"},
            {k: "relleno", l: "Relleno"},
            {k: "blanco", l: "Blanca"},
          ];

          document.getElementById("inv-body").innerHTML = TYPES.map(
            ({k, l}) => {
              const need = cnt[k],
                have = STOCK[k];
              const diff = have - need;
              const badge =
                diff >= 0
                  ? `<span class="badge ok">+${diff}</span>`
                  : `<span class="badge ko">${diff}</span>`;
              return `<tr><td>${l}</td><td>${need}</td><td>${have}</td><td>${badge}</td></tr>`;
            },
          ).join("");
        }

        document.getElementById("rsep").addEventListener("input", render);
        document.getElementById("risep").addEventListener("input", render);
        document.getElementById("rnz").addEventListener("input", render);
        render();

        document.getElementById("btn-dl").addEventListener("click", () => {
          const el = document.body;
          html2canvas(el, {scale: 2, useCORS: true}).then(canvas => {
            const link = document.createElement("a");
            link.download = "suelo-hidraulico.png";
            link.href = canvas.toDataURL("image/png");
            link.click();
          });
        });
      })();
    </script>
  </body>
</html>
